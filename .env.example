# ─────────────────────────────────────────────────────────────
# Mandatory Runtime Variables
# ─────────────────────────────────────────────────────────────
# These two variables are REQUIRED. The runner validates them at startup
# and exits immediately with a descriptive error if either is missing.
# (Validation is skipped during --self-test.)
#
# Your Google Gemini API key.
GEMINI_API_KEY=your-gemini-api-key-here

# Absolute path where output PPTX projects are copied after each agent run.
#
# Local / WSL DevTest:
#   OUTPUT_ARTIFACTS_DIR=/home/adminuser/ppt-outputs
#
# Docker / Cloud Run Job with a GCS bucket mounted at /workspace/outputs:
#   OUTPUT_ARTIFACTS_DIR=/workspace/outputs
#
OUTPUT_ARTIFACTS_DIR=/tmp/ppt-master-outputs

# ─────────────────────────────────────────────────────────────
# Optional: Agent Prompt
# ─────────────────────────────────────────────────────────────
# The prompt sent to the agent. Priority: --prompt CLI arg > AGENT_PROMPT > built-in default.
# Useful when configuring prompts via Cloud Run Job environment variables
# or GCP Secret Manager without changing the container image.
# AGENT_PROMPT=Create a 10-slide product launch deck for our new AI assistant.

# ─────────────────────────────────────────────────────────────
# Image Generation Configuration
# ─────────────────────────────────────────────────────────────

# This file is an optional fallback config source for image_gen.py.
# Current process environment variables take precedence over this file.
#
# Resolution order (only the FIRST existing file is read; keys are NOT merged across files):
#   1. ./.env in your current working directory
#   2. <skill-dir>/.env (skill install, e.g. ~/.agents/skills/ppt-master/.env)
#   3. <repo-root>/.env (when running from a clone)
#   4. ~/.ppt-master/.env (user-level config)

# Active backend (required)
# Recommended core backends: openai / gemini / qwen / zhipu / volcengine
# IMAGE_BACKEND=openai

# Max concurrent requests in --manifest batch mode (default 3).
# Auto-halves on rate-limit; 1 is the serial fallback.
# IMAGE_CONCURRENCY=3

# You may also provide the same variables directly via the current process environment.

# IMPORTANT:
# - IMAGE_API_KEY / IMAGE_MODEL / IMAGE_BASE_URL are no longer supported.
# - Use provider-specific keys only.

# ─────────────────────────────────────────────────────────────
# Example: OpenAI (recommended)
# ─────────────────────────────────────────────────────────────
# IMAGE_BACKEND=openai
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-image-2
# OPENAI_BASE_URL=http://127.0.0.1:3000/v1
# Allowed values: png / jpeg / webp
# OPENAI_OUTPUT_FORMAT=png
# jpeg/webp only, 0-100
# OPENAI_OUTPUT_COMPRESSION=80
# gpt-image-2: auto / opaque
# OPENAI_BACKGROUND=auto
# auto / low
# OPENAI_MODERATION=auto

# ─────────────────────────────────────────────────────────────
# Example: Gemini
# ─────────────────────────────────────────────────────────────
# IMAGE_BACKEND=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.1-flash-image-preview
# GEMINI_BASE_URL=https://your-proxy-url.com

# ─────────────────────────────────────────────────────────────
# Example: MiniMax
# ─────────────────────────────────────────────────────────────
# IMAGE_BACKEND=minimax
# MINIMAX_API_KEY=your-minimax-key
# MINIMAX_MODEL=image-01
# Default China endpoint
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1/image_generation
# Optional overseas endpoint
# MINIMAX_BASE_URL=https://api.minimax.io/v1/image_generation

# ─────────────────────────────────────────────────────────────
# Example: Qwen
# ─────────────────────────────────────────────────────────────
# IMAGE_BACKEND=qwen
# QWEN_API_KEY=your-dashscope-key
# QWEN_MODEL=qwen-image-2.0-pro
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis

# ─────────────────────────────────────────────────────────────
# Example: Zhipu
# ─────────────────────────────────────────────────────────────
# IMAGE_BACKEND=zhipu
# ZHIPU_API_KEY=your-zhipu-key
# ZHIPU_MODEL=glm-image
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/images/generations

# ─────────────────────────────────────────────────────────────
# Example: Volcengine
# ─────────────────────────────────────────────────────────────
# IMAGE_BACKEND=volcengine
# VOLCENGINE_API_KEY=your-volcengine-key
# VOLCENGINE_MODEL=doubao-seedream-4-5-251128
# VOLCENGINE_BASE_URL=https://operator.las.cn-beijing.volces.com/api/v1/images/generations

# ─────────────────────────────────────────────────────────────
# Extended / Experimental backends
# ─────────────────────────────────────────────────────────────
# STABILITY_API_KEY=your-stability-key
# STABILITY_MODEL=stable-image-core
# STABILITY_BASE_URL=https://api.stability.ai
#
# BFL_API_KEY=your-bfl-key
# BFL_MODEL=flux-pro-1.1-ultra
# BFL_BASE_URL=https://api.bfl.ai
#
# IDEOGRAM_API_KEY=your-ideogram-key
# IDEOGRAM_MODEL=ideogram-v3
# IDEOGRAM_BASE_URL=https://api.ideogram.ai
#
# MINIMAX_API_KEY=your-minimax-key
# MINIMAX_MODEL=image-01
# Default China endpoint
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1/image_generation
# Optional overseas endpoint
# MINIMAX_BASE_URL=https://api.minimax.io/v1/image_generation
#
# SILICONFLOW_API_KEY=your-siliconflow-key
# SILICONFLOW_MODEL=Qwen/Qwen-Image
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/images/generations
#
# FAL_KEY=your-fal-key
# FAL_MODEL=fal-ai/imagen3/fast
# FAL_BASE_URL=https://fal.run
#
# REPLICATE_API_TOKEN=r8_xxx
# REPLICATE_MODEL=black-forest-labs/flux-1.1-pro
# REPLICATE_BASE_URL=https://api.replicate.com/v1/predictions
#
# OPENROUTER_API_KEY=sk-or-v1-xxx
# OPENROUTER_MODEL=google/gemini-3.1-flash-image-preview
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# IMAGE_BACKEND=modelscope
# MODELSCOPE_API_KEY=your-modelscope-key
# MODELSCOPE_MODEL=Tongyi-MAI/Z-Image-Turbo
# MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# ─────────────────────────────────────────────────────────────
# Multi-provider example
# ─────────────────────────────────────────────────────────────
# IMAGE_BACKEND=openai
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-image-2
# OPENAI_OUTPUT_FORMAT=png
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.1-flash-image-preview
#
# Switch providers by changing IMAGE_BACKEND only.

# ─────────────────────────────────────────────────────────────
# Audio narration TTS (notes_to_audio.py)
# ─────────────────────────────────────────────────────────────
# edge-tts is the default narration backend and needs no API key.
# Use cloud providers only when you want high-quality or cloned voices —
# all four (ElevenLabs / MiniMax / Qwen / CosyVoice) accept a cloned voice_id.
# Clone the voice in the provider's console first, then pass --voice-id to
# notes_to_audio.py. See docs/audio-narration.md "Use a cloned voice".
#
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# MINIMAX_API_KEY=your-minimax-key
# QWEN_API_KEY=your-dashscope-key
# COSYVOICE_API_KEY=your-dashscope-key
# DASHSCOPE_API_KEY=your-dashscope-key
#
# Optional provider-specific TTS endpoint overrides.
# Default China endpoint
# MINIMAX_TTS_BASE_URL=https://api.minimaxi.com/v1/t2a_v2
# Optional overseas endpoint
# MINIMAX_TTS_BASE_URL=https://api.minimax.io/v1/t2a_v2
# QWEN_TTS_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# COSYVOICE_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer

# ─────────────────────────────────────────────────────────────
# Web image search (image_search.py)
# ─────────────────────────────────────────────────────────────
# Used by scripts/image_search.py — separate from IMAGE_BACKEND above.
#
# Openverse and Wikimedia work with no key, but image quality can be uneven.
# For polished stock-style PPT images, configure Pexels and/or Pixabay.
#
# Sign up: https://www.pexels.com/api/
# PEXELS_API_KEY=your-pexels-key
# Sign up: https://pixabay.com/api/docs/
# PIXABAY_API_KEY=your-pixabay-key

# ─────────────────────────────────────────────────────────────
# Auto Resumption Watchdog
# ─────────────────────────────────────────────────────────────
# Number of recent project folders the auto_resume watchdog script should verify.
# If incomplete projects are found within this depth, they will be auto-resumed.
# Defaults to 3.
WATCHDOG_DEPTH=3

# run_agent.py silent-failure retry guard:
# If a run exits without producing a NEW .pptx under OUTPUT_ARTIFACTS_DIR,
# the runner retries automatically.
# Value = TOTAL attempts including the first (default: 3, minimum: 1).
RUN_AGENT_MAX_RETRIES=3

# ─────────────────────────────────────────────────────────────
# GCP Pub/Sub Integration (Status Progress updates)
# ─────────────────────────────────────────────────────────────
# The status feed is published to GCP Pub/Sub whenever a topic is targetable.
# It auto-enables on Cloud Run (Jobs set CLOUD_RUN_JOB/CLOUD_RUN_EXECUTION,
# Services set K_SERVICE); locally, just set STATUS_PUBSUB_TOPIC below.
#
# Events are published with message ordering ON, keyed by RUN_ID, so the consumer
# receives them in emission order ONLY IF its subscription also enables ordering:
#   gcloud pubsub subscriptions create status-progress-sub \
#       --topic=status-progress --enable-message-ordering
#
# Explicit topic (required to publish from outside Cloud Run, e.g. local testing):
# STATUS_PUBSUB_TOPIC=projects/your-project-id/topics/status-progress
#
# Project id — used to derive the default topic (projects/<id>/topics/status-progress)
# on Cloud Run when STATUS_PUBSUB_TOPIC is unset. GOOGLE_CLOUD_PROJECT or GCP_PROJECT.
# GOOGLE_CLOUD_PROJECT=your-project-id
#
# Per-run id stamped on every event AND used as the Pub/Sub ordering key so the
# frontend can group a run's events. Defaults to CLOUD_RUN_EXECUTION, else a
# timestamp. Set explicitly to correlate with your own job/run identifier.
# RUN_ID=
#
# Credentials for publishing:
#   - Local: run `gcloud auth application-default login` (ADC) — nothing to set here.
#   - Or point at a service-account key file (least preferred):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
#   - Hosted: grant the Cloud Run runtime SA roles/pubsub.publisher (no key file).
#
# Fully offline testing with the Pub/Sub emulator (no GCP, no ADC). The client
# auto-detects this; start it via `gcloud beta emulators pubsub start`.
# (Note: emulator message-ordering support is partial — fine for smoke tests.)
# PUBSUB_EMULATOR_HOST=localhost:8085

# ─────────────────────────────────────────────────────────────
# Status Progress Tuning (optional)
# ─────────────────────────────────────────────────────────────
# Knobs for how the status logger parses the agent's streamed output. Both have
# safe built-in defaults; set them only to tune behavior. Invalid/out-of-range
# values fall back to the default (a warning is logged) and never crash logging.
#
# Overlap (in characters) re-scanned at the tail of the reasoning/text buffer on
# each streamed chunk, so a marker split across a chunk boundary is still caught.
# Larger only costs a little CPU; must exceed the longest pattern matched.
# Default: 1024. Minimum: 64.
# STATUS_SCAN_OVERLAP_CHARS=1024
#
# Max number of research sub-topic headers surfaced from the model's reasoning
# per run (the "Researching: ..." lines). Default: 8.
# STATUS_MAX_RESEARCH_HEADERS=8

